# gobabel/scripts/build_flutter_web
#
#
#!/bin/sh
# Makes sure we break the script on any error.
set -e
# Build the web app.
cd zenscrap_flutter
flutter pub get
flutter build web --release
cd ..
# Copy the build files into the web/app directory.
rm -rf zenscrap_server/web/app
cp -r zenscrap_flutter/build/web zenscrap_server/web/app
# Note: We keep index.html in web/app for proper SPA routing